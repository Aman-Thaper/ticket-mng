{
  "title": "Ticket MNG",
  "uid": "ticket-mng",
  "schemaVersion": 39,
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests/s by status",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (status_code) (rate(http_request_duration_seconds_count[1m]))",
          "legendFormat": "{{status_code}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 latency by route (s)",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Seat hold attempts/s by outcome",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (outcome) (rate(booking_hold_attempts_total[1m]))", "legendFormat": "{{outcome}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "DB pool: requests waiting for a connection",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (instance) (db_pool_connections{state=\"waiting\"})",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Event loop lag p99 (s)",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "max by (instance) (nodejs_eventloop_lag_p99_seconds)", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Live WebSocket connections",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(websocket_connections)", "legendFormat": "connections" }]
    },
    {
      "type": "timeseries",
      "title": "Queue depth",
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (queue, state) (queue_jobs{state=~\"waiting|active|delayed\"})",
          "legendFormat": "{{queue}} {{state}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Dead letters (needs a human)",
      "gridPos": { "x": 8, "y": 16, "w": 4, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(queue_jobs{queue=\"dead-letter\", state=\"waiting\"})" }]
    },
    {
      "type": "stat",
      "title": "Outbox backlog (oldest, s)",
      "gridPos": { "x": 12, "y": 16, "w": 4, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "max(outbox_unpublished{measure=\"oldest_seconds\"})" }]
    },
    {
      "type": "timeseries",
      "title": "Job p95 duration by queue (s)",
      "gridPos": { "x": 16, "y": 16, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, queue) (rate(job_duration_seconds_bucket[5m])))",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cache hit ratio",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (cache) (rate(cache_requests_total{result=~\"hit|coalesced\"}[5m])) / sum by (cache) (rate(cache_requests_total[5m]))",
          "legendFormat": "{{cache}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests in flight",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (instance) (http_requests_in_flight)", "legendFormat": "{{instance}}" }]
    }
  ]
}
