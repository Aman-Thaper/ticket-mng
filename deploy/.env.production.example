# Copy to /srv/ticket-mng/.env.production on the server (never commit the real file) and fill in.
# Generate secrets with the commands shown. See docs/DEPLOY.md.

APP_URL=https://tickets.example.com
LOG_LEVEL=info

# ---- database (the compose Postgres, or a managed one)
POSTGRES_USER=ticket
POSTGRES_DB=ticket_mng
POSTGRES_PASSWORD=change-me            # openssl rand -base64 24
DATABASE_URL=postgres://ticket:change-me@postgres:5432/ticket_mng
DB_POOL_MAX=20

REDIS_URL=redis://redis:6379/0

# ---- secrets
JWT_ACCESS_SECRET=change-me            # openssl rand -base64 48
TICKET_SIGNING_KEY=change-me           # openssl rand -base64 32
METRICS_TOKEN=change-me                # openssl rand -hex 24

# ---- payments (Stripe; webhook endpoint https://<domain>/api/v1/webhooks/stripe)
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- object storage (e.g. Cloudflare R2 or AWS S3; create the bucket + public-read on posters/*)
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_PUBLIC_URL=https://<public bucket host>
S3_REGION=auto
S3_ACCESS_KEY=...
S3_SECRET_KEY=...
S3_BUCKET=ticket-media

# ---- email (any SMTP provider: Postmark, SES, Mailgun, ...)
SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM="Ticket MNG <tickets@example.com>"
