# Production site config. The official Nginx image renders this template (substituting
# ${DOMAIN}) into /etc/nginx/conf.d/, inside its default http {} block.

resolver 127.0.0.11 valid=2s ipv6=off;

upstream api {
  zone api 64k;
  least_conn;
  # The servers: normally "api", which Docker's DNS resolves to every replica. Written at
  # startup by deploy/nginx/api-upstream.sh, and swapped by deploy/rollout.sh during deploys.
  include /etc/nginx/upstream-api.conf;
  keepalive 64;
}

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      '';
}

# Edge rate limit per client IP: a coarse first line of defence that sheds floods before
# they reach Node. The API enforces its own, finer per-IP/per-user limits behind this.
limit_req_zone $binary_remote_addr zone=per_ip:20m rate=50r/s;
limit_req_status 429;

log_format json escape=json
  '{"time":"$time_iso8601","request_id":"$request_id","client":"$remote_addr",'
  '"method":"$request_method","uri":"$request_uri","status":$status,"bytes":$body_bytes_sent,'
  '"duration_s":$request_time,"upstream":"$upstream_addr","upstream_s":"$upstream_response_time"}';

server {
  listen 80;
  server_name ${DOMAIN};
  access_log /dev/stdout json;

  # Let's Encrypt HTTP-01 challenges (first issuance and renewals).
  location /.well-known/acme-challenge/ {
    root /var/www/acme;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMAIN};
  access_log /dev/stdout json;

  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;

  # Browsers: only ever use HTTPS for this site; don't sniff types; don't be framed.
  add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  client_max_body_size 1m;
  gzip on;
  gzip_types application/json text/css application/javascript image/svg+xml;

  location = /metrics {
    return 404; # scraped inside the Docker network only
  }

  location / {
    limit_req zone=per_ip burst=100 nodelay;
    proxy_pass http://api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-Id $request_id;
    # A replica that was just removed leaves an IP that nothing answers, so a connection
    # attempt would hang for the default 60 s. Connecting inside one host takes microseconds:
    # give up after 2 s and retry on another replica (the request was never sent, so this is
    # safe even for POST).
    proxy_connect_timeout 2s;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
    # Never retry deliberate 503s (load shedding): see deploy/nginx/local.conf.
    proxy_next_upstream error timeout;
  }
}
