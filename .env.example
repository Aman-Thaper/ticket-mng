NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Public URL of the app; used to build links in emails.
APP_URL=http://localhost:3000

DATABASE_URL=postgres://ticket:ticket@localhost:5432/ticket_mng
REDIS_URL=redis://localhost:6379/0

# Tests use their own database and Redis DB index. Both are wiped before every test.
TEST_DATABASE_URL=postgres://ticket:ticket@localhost:5432/ticket_mng_test
TEST_REDIS_URL=redis://localhost:6379/15

# Signs access tokens. Generate a real one with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-secret-do-not-use-in-production-0123456789
# true in production (HTTPS only). Must stay false for http://localhost.
COOKIE_SECURE=false

# Mailpit catches all mail locally: inbox at http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Ticket MNG <no-reply@ticket-mng.local>"
