NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Public URL of the app; used to build links in emails.
APP_URL=http://localhost:3000

DATABASE_URL=postgres://ticket:ticket@localhost:5432/ticket_mng
REDIS_URL=redis://localhost:6379/0

# Tests use their own database and Redis DB index. Both are wiped before every test.
TEST_DATABASE_URL=postgres://ticket:ticket@localhost:5432/ticket_mng_test
TEST_REDIS_URL=redis://localhost:6379/15

# Signs access tokens. Generate a real one with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-secret-do-not-use-in-production-0123456789
# true in production (HTTPS only). Must stay false for http://localhost.
COOKIE_SECURE=false

# Mailpit catches all mail locally: inbox at http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Ticket MNG <no-reply@ticket-mng.local>"
# To send real email through Resend instead (docs/DEPLOY.md#email): create an API key at
# resend.com/api-keys. Until you verify a domain, Resend only delivers to your own Resend
# account's address, sent from onboarding@resend.dev:
#   MAIL_TRANSPORT=resend
#   RESEND_API_KEY=re_...
#   MAIL_FROM="Ticket MNG <onboarding@resend.dev>"
# After verifying your domain at resend.com/domains, send from it, to anyone:
#   MAIL_FROM="Ticket MNG <tickets@yourdomain.com>"
#   MAIL_REPLY_TO=support@yourdomain.com

# Signs ticket QR codes (Ed25519 seed, 32 bytes). Generate your own: openssl rand -base64 32
TICKET_SIGNING_KEY=+mPtSKxHNhPA3r7ZOfCIbAdEMXWeVaymIJBr0hB2x3I=

# Object storage: MinIO locally (console http://localhost:9001, minioadmin/minioadmin)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ticket-media

# Behind a reverse proxy on this host (see scripts/cluster.sh), trust it for X-Forwarded-For:
# TRUST_PROXY=loopback
# Per-client-IP API limit (bursts / sustained per second):
# RATE_LIMIT_IP_CAPACITY=120
# RATE_LIMIT_IP_REFILL_PER_SEC=30
