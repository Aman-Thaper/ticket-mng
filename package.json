{
  "name": "ticket-mng",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts latest",
    "migrate:down": "tsx src/db/migrate.ts down",
    "seed": "tsx scripts/seed.ts",
    "stock": "tsx scripts/stock-events.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "race": "tsx scripts/race-test.ts",
    "worker": "tsx watch src/worker.ts",
    "start:worker": "node dist/worker.js",
    "check:invariants": "tsx scripts/check-invariants.ts",
    "loadtest:setup": "tsx scripts/loadtest/setup.ts",
    "loadtest": "k6 run scripts/loadtest/flash-sale.js",
    "e2e": "tsx scripts/e2e-seatmap.ts",
    "build": "tsc -p tsconfig.build.json",
    "migrate:prod": "node dist/db/migrate.js latest",
    "dev:pretty": "LOG_PRETTY=true tsx watch src/server.ts"
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-presigned-post": "^3.1141.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.5",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.1",
    "@node-rs/argon2": "^2.2.1",
    "bullmq": "^6.3.9",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "nodemailer": "^10.0.11",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
